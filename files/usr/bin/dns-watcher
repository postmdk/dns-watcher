#!/bin/sh

# shellcheck source=/dev/null
. /lib/functions.sh

# Function to retrieve the primary DNS server assigned to a specified interface
get_interface_dns() {
    local_ifname="$1"
    local dns=""

    if [ -n "$local_ifname" ]; then
        # Read static DNS configuration from UCI
        dns=$(uci -q get "network.$local_ifname.dns")
        # If UCI DNS is unset, query dynamic DNS assigned by netifd via ubus
        if [ -z "$dns" ]; then
            dns=$(ubus call "network.interface.$local_ifname" status 2>/dev/null | jsonfilter -e '@["dns-server"][0]' 2>/dev/null || true)
        fi
    fi
    echo "$dns"
}

state=-1
logger -t dns-watcher "Starting DNS tunnel watcher daemon..."

# Initial check for enabled status and startup delay
config_load 'dns-watcher'
config_get ENABLED 'settings' 'enabled' '1'
config_get STARTUP_DELAY 'settings' 'startup_delay' '10'

[ "$ENABLED" != "1" ] && exit 0
if [ "$STARTUP_DELAY" -gt 0 ]; then
    sleep "$STARTUP_DELAY"
fi

# Main monitoring loop with dynamic configuration reloading on each cycle
while true; do
    # 1. Reload settings dynamically from UCI to apply on-the-fly configuration changes
    config_load 'dns-watcher'
    config_get INTERFACE 'settings' 'interface' ''
    config_get TARGET_DNS 'settings' 'target_dns' ''
    config_get INTERVAL 'settings' 'interval' '5'
    config_get HOOK_UP 'settings' 'on_reachable' '/etc/dns-watcher/up.sh'
    config_get HOOK_DOWN 'settings' 'on_unreachable' '/etc/dns-watcher/down.sh'

    # Determine the current active target DNS server IP address
    ACTIVE_DNS=""
    if [ -n "$INTERFACE" ]; then
        ACTIVE_DNS=$(get_interface_dns "$INTERFACE")
    fi
    [ -z "$ACTIVE_DNS" ] && ACTIVE_DNS="$TARGET_DNS"

    # If no target DNS address could be determined, wait for network or configuration updates
    while [ -z "$ACTIVE_DNS" ]; do
        logger -t dns-watcher "Error: Target DNS IP is empty. Waiting for interface/config..."
        sleep "$INTERVAL"
        
        config_load 'dns-watcher'
        config_get INTERFACE 'settings' 'interface' ''
        config_get TARGET_DNS 'settings' 'target_dns' ''
        config_get INTERVAL 'settings' 'interval' '5'
        
        if [ -n "$INTERFACE" ]; then
            ACTIVE_DNS=$(get_interface_dns "$INTERFACE")
        fi
        [ -z "$ACTIVE_DNS" ] && ACTIVE_DNS="$TARGET_DNS"
    done

    # 2. Test reachability of the active DNS server
    if nslookup -port=53 -timeout=1 root-servers.net "$ACTIVE_DNS" >/dev/null 2>&1; then
        current_state=1
    else
        # Perform double-check validation only if previously in a reachable state (state=1 or initial state=-1)
        if [ "$state" -ne 0 ]; then
            logger -t dns-watcher "DNS ($ACTIVE_DNS) is not responding. Re-reading config and re-checking..."
            
            config_load 'dns-watcher'
            config_get INTERFACE 'settings' 'interface' ''
            config_get TARGET_DNS 'settings' 'target_dns' ''
            
            if [ -n "$INTERFACE" ]; then
                ACTIVE_DNS=$(get_interface_dns "$INTERFACE")
            fi
            [ -z "$ACTIVE_DNS" ] && ACTIVE_DNS="$TARGET_DNS"

            # Perform second query attempt with reloaded parameters
            if nslookup -port=53 -timeout=1 root-servers.net "$ACTIVE_DNS" >/dev/null 2>&1; then
                current_state=1
                logger -t dns-watcher "DNS check passed after re-reading config. Staying reachable."
            else
                current_state=0
            fi
        else
            # If already in fallback mode (state=0), quietly retain unreachable state without repeated re-check logs
            current_state=0
        fi
    fi

    # 3. Trigger lifecycle hook scripts upon state transition
    if [ "$current_state" -ne "$state" ]; then
        state=$current_state
        if [ "$state" -eq 1 ]; then
            logger -t dns-watcher "Tunnel DNS ($ACTIVE_DNS) is reachable."
            if [ -x "$HOOK_UP" ]; then
                "$HOOK_UP"
            fi
        else
            logger -t dns-watcher "Tunnel DNS ($ACTIVE_DNS) is unreachable. Switching to fallback."
            if [ -x "$HOOK_DOWN" ]; then
                "$HOOK_DOWN"
            fi
        fi
    fi

    sleep "$INTERVAL"
done
